BOT_TOKEN="Your Discord bot token"
BACKEND_URL="http://localhost:4000"
# Must match BOT_API_SECRET in the backend's .env
BOT_API_SECRET="Your bot API secret for secure communication between the bot and backend"

# Register slash commands to this guild only (instant updates). Leave empty in production to
# register them globally.
DEV_GUILD_ID=""

# Where "joined a new guild" notices and critical errors are posted. Leave empty to disable.
LOG_CHANNEL_ID="1450636734747508869"
CRITICAL_ERROR_CHANNEL_ID="1450631087125430282"

# debug | info | warn | error
LOG_LEVEL="info"
