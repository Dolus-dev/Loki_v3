# development | test | production (defaults to development). Outside production the database
# schema is created and updated automatically on startup.
NODE_ENV="development"
PORT="4000"
# PostgreSQL connection string for an (initially empty) Loki database
DATABASE_URL="postgres://user:password@localhost:5432/loki"
REDIS_PASSWORD="Your Redis password"
SESSION_SECRET="A strong secret for session management"
# Where the dashboard and this API run locally (`pnpm dev` uses ports 3000 and 4000)
FRONTEND_ORIGIN="http://localhost:3000"
BACKEND_ORIGIN="http://localhost:4000"
DISCORD_CLIENT_ID="Your Discord client ID"
DISCORD_CLIENT_SECRET="Your Discord client secret"
# Must also be added as a redirect URI in the Discord developer portal (OAuth2 tab)
DISCORD_REDIRECT_URI="http://localhost:4000/auth/callback"
BOT_TOKEN="Your Discord bot token"
BOT_API_SECRET="Your bot API secret for secure communication between the bot and backend"
# A local Redis on its standard port
REDIS_HOST="localhost"
REDIS_PORT="6379"
# Set to "true" to DROP the whole database on every start (development only)
DB_RESET="false"

# 32 random bytes, base64-encoded; encrypts stored Discord tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY="Your generated 32-byte base64 key"

# Number of reverse proxies in front of this server (0 = none). Set to 1 when deployed behind
# Nginx, Caddy or a hosting platform that terminates HTTPS; keep 0 for local development.
TRUST_PROXY="0"
