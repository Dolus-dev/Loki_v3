{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"backend": {
			"root": "apps/backend",
			"framework": "express",
			"installCommand": "pnpm install --ignore-workspace --no-frozen-lockfile"
		},
		"web": {
			"root": "apps/web",
			"framework": "nextjs"
		}
	},
	"rewrites": [
		{
			"source": "/(.*)",
			"has": [{ "type": "host", "value": { "pre": "api." } }],
			"destination": { "service": "backend" }
		},
		{
			"source": "/(.*)",
			"destination": { "service": "web" }
		}
	]
}
